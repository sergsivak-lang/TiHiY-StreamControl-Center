<Window x:Class="TiHiY.StreamControlMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TiHiY StreamControl MINI"
        Width="1240" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="{StaticResource Bg}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="14,9" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.png" Width="50" Height="50" Stretch="Uniform" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TiHiY" FontSize="25" FontWeight="Black" Foreground="{StaticResource Cyan}"/>
                            <TextBlock Text="  StreamControl MINI" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                        </StackPanel>
                        <TextBlock Text="MULTICHAT  •  DONATIONS  •  NOTIFICATIONS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#151428" BorderBrush="#7546B7" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3">
                        <TextBlock x:Name="TwitchStatusText" Text="TWITCH: ..." FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#2B1115" BorderBrush="#A83C45" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3">
                        <TextBlock x:Name="YouTubeStatusText" Text="YOUTUBE: ..." FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#29230B" BorderBrush="#A68B21" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3">
                        <TextBlock x:Name="DonatelloStatusText" Text="DONATELLO: ..." FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="ПІДКЛЮЧЕННЯ" Click="Connections_Click" Margin="9,3,3,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*" MinWidth="310"/>
            </Grid.ColumnDefinitions>

            <!-- MULTICHAT -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="МУЛЬТИЧАТ" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="20"/>
                            <TextBlock x:Name="ChatStatusText" Text="Twitch + YouTube" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Twitch + YouTube" Foreground="{StaticResource Amber}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>

                    <ListBox x:Name="ChatList" Grid.Row="1" ItemsSource="{Binding ChatMessages}" Background="#08131C" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Background}" Padding="7,5" Margin="2,1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="62"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Platform}" Foreground="{StaticResource Amber}" FontSize="10" FontWeight="Bold" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding User}" Foreground="{Binding Foreground}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="4,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{Binding Foreground}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DisplayTime}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="ChatInput" Grid.Row="0" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" KeyDown="ChatInput_KeyDown" ToolTip="Enter — надіслати в обидва чати; Shift+Enter — новий рядок"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button x:Name="SendTwitchButton" Content="TWITCH" Click="SendTwitch_Click"/>
                            <Button x:Name="SendYouTubeButton" Content="YOUTUBE" Click="SendYouTube_Click"/>
                            <Button x:Name="SendBothButton" Content="В ОБИДВА" Click="SendBoth_Click" BorderBrush="{StaticResource Amber}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT SIDE: NOTIFICATIONS + DONATIONS -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1.08*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="СПОВІЩЕННЯ" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="19"/>
                            <TextBlock Text="важливі події стріму" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="NotificationList" Grid.Row="1" ItemsSource="{Binding Notifications}" Background="#08131C" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1D3746" BorderThickness="0,0,0,1" Padding="7">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Amber}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" Foreground="{StaticResource Muted}" FontSize="10" Margin="8,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ДОНАТИ" Foreground="{StaticResource Amber}" FontWeight="Bold" FontSize="19"/>
                                <TextBlock x:Name="DonationSummaryText" Text="Donatello • Super Chat • Bits" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="TEST" Click="TestDonation_Click" Padding="9,4"/>
                        </Grid>
                        <ListBox x:Name="DonationList" Grid.Row="1" ItemsSource="{Binding Donations}" Background="#08131C" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#2D3521" BorderThickness="0,0,0,1" Padding="7">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding User}" Foreground="{StaticResource Amber}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayAmount}" Foreground="{StaticResource Green}" FontWeight="Bold"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" Foreground="{StaticResource Muted}" FontSize="9"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DonationTotalText" Grid.Row="2" Text="Зібрано: 0 UAH" HorizontalAlignment="Right" Foreground="{StaticResource Green}" FontWeight="Bold" Margin="0,8,2,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
